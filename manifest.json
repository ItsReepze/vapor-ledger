{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Vapor Ledger",
  "version": "0.4.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://steamcommunity.com/*",
    "https://api.isthereanydeal.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/lib/request.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/*"
      ],
      "js": [
        "src/content/link.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/account/",
        "https://store.steampowered.com/account/?*"
      ],
      "js": [
        "src/lib/util.js",
        "src/lib/i18n.js",
        "src/lib/settings.js",
        "src/lib/request.js",
        "src/lib/history.js",
        "src/lib/steam.js",
        "src/lib/prices.js",
        "src/lib/community.js",
        "src/lib/market.js",
        "src/lib/stats.js",
        "src/lib/insights.js",
        "src/lib/export.js",
        "src/lib/cache.js",
        "src/lib/sources.js",
        "src/ledger/styles.js",
        "src/ledger/table.js",
        "src/ledger/charts.js",
        "src/ledger/views.js",
        "src/ledger/recap.js",
        "src/ledger/inventory.js",
        "src/ledger/settings-view.js",
        "src/ledger/page.js",
        "src/ledger/start.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/id/*/edit*",
        "https://steamcommunity.com/profiles/*/edit*"
      ],
      "js": [
        "src/lib/util.js",
        "src/lib/i18n.js",
        "src/lib/settings.js",
        "src/content/common.js",
        "src/content/profile-edit.js"
      ],
      "css": [
        "src/content/steam-tools.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://store.steampowered.com/account/history*",
        "https://store.steampowered.com/account/licenses*"
      ],
      "js": [
        "src/lib/util.js",
        "src/lib/i18n.js",
        "src/lib/settings.js",
        "src/lib/history.js",
        "src/content/common.js",
        "src/content/history-tools.js",
        "src/content/licenses-tools.js"
      ],
      "css": [
        "src/content/steam-tools.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Vapor Ledger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vapor-ledger@reepze.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
